# Writes OUTPUT, a C++ header holding compiled shaders as uint32_t arrays,
# from glslc's C-style output (-mfmt=c). INPUTS is a list of name=file pairs
# separated by | (a ; would split the argument); COMPILER is the first line of
# `glslc --version`, which the header records.
# The file is rewritten only when it changes.
#   cmake -DOUTPUT=<header> -DCOMPILER=<version> "-DINPUTS=a=a.inc|b=b.inc" -P Ps2nSpirvHeader.cmake
string(REPLACE "|" ";" INPUTS "${INPUTS}")
set(text "// Generated by cmake/Ps2nSpirvHeader.cmake from the shaders in runtime/src/gpu/shaders: do not edit.\n")
string(APPEND text "// A build with glslc makes it afresh; after changing a shader, build the ps2n_update_shaders\n")
string(APPEND text "// target, which copies it over runtime/src/gpu/shaders/ps2n_spirv.h, what builds without glslc\n")
string(APPEND text "// use (the test gpu_shaders_are_current checks that the two agree).\n")
string(APPEND text "#pragma once\n\n#include <cstdint>\n\nnamespace ps2::gpu::spirv {\n\n")
string(APPEND text "inline constexpr char kCompiler[] = \"${COMPILER}\";\n")
foreach(pair IN LISTS INPUTS)
    string(FIND "${pair}" "=" eq)
    string(SUBSTRING "${pair}" 0 ${eq} name)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${pair}" ${start} -1 file)
    file(READ "${file}" words)
    string(REPLACE "\r" "" words "${words}")
    string(STRIP "${words}" words)
    string(APPEND text "\ninline constexpr uint32_t ${name}[] = ${words};\n")
endforeach()
string(APPEND text "\n} // namespace ps2::gpu::spirv\n")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
